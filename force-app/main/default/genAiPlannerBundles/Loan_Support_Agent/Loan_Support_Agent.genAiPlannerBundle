            <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
            <localDeveloperName>Get_EMI_Schedules</localDeveloperName>
            <masterLabel>Get EMI Schedules</masterLabel>
            <progressIndicatorMessage>Fetching your EMI schedule...</progressIndicatorMessage>
            <source>Get_EMI_Schedules</source>
        </localActions>
        <localDeveloperName>EMI_Schedule_Inquiry</localDeveloperName>
        <masterLabel>EMI Schedule Inquiry</masterLabel>
        <pluginType>Topic</pluginType>
        <scope>Handle all queries related to EMI payment schedules. Always ask for the loan number in format LN-001 before proceeding. Call the Get EMI Schedule action to retrieve upcoming pending EMIs.</scope>
