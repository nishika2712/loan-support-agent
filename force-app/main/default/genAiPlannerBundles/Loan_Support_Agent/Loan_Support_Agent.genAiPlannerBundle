    <localTopics>
        <fullName>General_Loan_FAQ_16jg8000000RtTS</fullName>
        <canEscalate>false</canEscalate>
        <description>Use this topic for general questions about missed EMIs, repayment options, loan closure, or any query not covered by loan status or EMI schedule topics.</description>
        <developerName>General_Loan_FAQ_16jg8000000RtTS</developerName>
        <language>en_US</language>
        <localDeveloperName>General_Loan_FAQ</localDeveloperName>
        <masterLabel>General Loan FAQ</masterLabel>
        <pluginType>Topic</pluginType>
        <scope>Answer general loan servicing questions without calling any external action. If a customer mentions a missed EMI, respond with empathy and advise them to contact their loan officer. If asked about loan closure, confirm the loan is closed and no further EMIs are due. Keep responses professional and concise.</scope>
